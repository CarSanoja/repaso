# Leave REPASO_AWS_REGION unset to run fully offline (local mode auto-derives).
REPASO_AWS_REGION=
REPASO_LOCAL_DATA_DIR=.local_data

# Set REPASO_CASSETTE_PATH to replay recorded model outputs offline, and
# REPASO_RECORD_CASSETTE_PATH on a cloud run to write the recording.
REPASO_CASSETTE_PATH=
REPASO_RECORD_CASSETTE_PATH=

# Verify exact inference profile ids in your account: aws bedrock list-inference-profiles
REPASO_MODEL_GENERATE=us.anthropic.claude-sonnet-4-6
REPASO_MODEL_JUDGE=us.anthropic.claude-sonnet-4-6
REPASO_MODEL_STRUCTURED=us.anthropic.claude-haiku-4-5-20251001-v1:0
REPASO_MODEL_CLASSIFY=us.amazon.nova-lite-v1:0
REPASO_MODEL_PROBE=us.amazon.nova-micro-v1:0

REPASO_DDB_TABLE=repaso
REPASO_MEDIA_BUCKET=
REPASO_CURRICULUM_BUCKET=
REPASO_EVENT_BUS=repaso
REPASO_SCHEDULER_GROUP=repaso
REPASO_TELEGRAM_SECRET_NAME=repaso/telegram
REPASO_JUDGE_CODE_SECRET_NAME=repaso/judge

REPASO_COHORT_MIN_FAMILIES=3
REPASO_GRADER_CONFIDENCE_THRESHOLD=0.85
REPASO_ESCALATION_MIN_SAMPLES=5

REPASO_LIVE_TESTS=0
