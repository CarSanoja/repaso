{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StateStoreTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:ConditionCheckItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:123456789012:table/repaso",
        "arn:aws:dynamodb:us-east-1:123456789012:table/repaso/index/gsi1"
      ]
    },
    {
      "Sid": "MediaBucketObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::REPASO_MEDIA_BUCKET/*"
      ]
    },
    {
      "Sid": "MediaBucketListing",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::REPASO_MEDIA_BUCKET"
      ]
    },
    {
      "Sid": "CurriculumBucketRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::REPASO_CURRICULUM_BUCKET",
        "arn:aws:s3:::REPASO_CURRICULUM_BUCKET/*"
      ]
    },
    {
      "Sid": "MediaBucketKey",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": [
        "arn:aws:kms:us-east-1:123456789012:key/REPASO_KEY_ID"
      ]
    },
    {
      "Sid": "ChannelJudgeAndInviteSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:123456789012:secret:repaso/telegram-*",
        "arn:aws:secretsmanager:us-east-1:123456789012:secret:repaso/judge-*",
        "arn:aws:secretsmanager:us-east-1:123456789012:secret:repaso/pilot-invite-codes-*"
      ]
    },
    {
      "Sid": "EventBusPublish",
      "Effect": "Allow",
      "Action": [
        "events:PutEvents"
      ],
      "Resource": [
        "arn:aws:events:us-east-1:123456789012:event-bus/repaso"
      ]
    },
    {
      "Sid": "FamilyAlarmSchedules",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:DeleteSchedule",
        "scheduler:GetSchedule",
        "scheduler:ListSchedules"
      ],
      "Resource": [
        "arn:aws:scheduler:us-east-1:123456789012:schedule/repaso/*"
      ]
    },
    {
      "Sid": "PassSchedulerRole",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/repaso-scheduler"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    },
    {
      "Sid": "MaterialTextExtraction",
      "Effect": "Allow",
      "Action": [
        "textract:DetectDocumentText"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ProjectMetrics",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "repaso"
        }
      }
    },
    {
      "Sid": "CurriculumKnowledgeBaseRetrieve",
      "Effect": "Allow",
      "Action": [
        "bedrock:Retrieve"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1:123456789012:knowledge-base/REPASO_KNOWLEDGE_BASE_ID"
      ]
    },
    {
      "Sid": "IntakeGuardrail",
      "Effect": "Allow",
      "Action": [
        "bedrock:ApplyGuardrail"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1:123456789012:guardrail/REPASO_GUARDRAIL_ID"
      ]
    }
  ]
}
